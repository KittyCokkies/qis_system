# =============================================================================
# QIS System - Airflow 环境变量配置
# 复制为 .env 后修改
# =============================================================================

# 本地 PostgreSQL 数据库（项目数据库）
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/qis_system

# 通联数据库配置
TONGLIAN_HOST=192.168.27.112
TONGLIAN_PORT=3306
TONGLIAN_DB=datayesdb
TONGLIAN_USER=your_username
TONGLIAN_PASSWORD=your_password

# Airflow 配置（可选，用于生产环境）
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
AIRFLOW__SMTP__SMTP_USER=alert@example.com
AIRFLOW__SMTP__SMTP_PASSWORD=your_smtp_password
