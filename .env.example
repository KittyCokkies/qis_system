# QIS System - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qis_db
DB_USER=qis_user
DB_PASSWORD=your_secure_password_here

# Full database URL (optional, will be constructed from above if not set)
# DATABASE_URL=postgresql://qis_user:password@localhost:5432/qis_db

# ============================================
# Data Source - Wind (万得)
# ============================================
# Wind Python API (typically no credentials needed if using terminal login)
WINDPY_ENABLED=true

# ============================================
# Data Source - Tonglian (MySQL)
# ============================================
TONGLIAN_HOST=tonglian-mysql-server
TONGLIAN_PORT=3306
TONGLIAN_USER=tonglian_user
TONGLIAN_PASSWORD=tonglian_password
TONGLIAN_DATABASE=tonglian_db

# ============================================
# Data Source - Swifquant
# ============================================
SWIFQUANT_ENABLED=true
SWIFQUANT_BASE_URL=https://api.swifquant.com
SWIFQUANT_API_KEY=your_swifquant_api_key

# ============================================
# Data Source - Bloomberg (Excel files)
# ============================================
# Path to Bloomberg Excel exports directory
BLOOMBERG_EXCEL_PATH=./data/bloomberg_exports

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/qis_system.log

# ============================================
# Strategy Execution
# ============================================
# Default backtest start date (YYYY-MM-DD)
DEFAULT_BACKTEST_START=2020-01-01
# Risk-free rate for Sharpe calculations (annualized)
RISK_FREE_RATE=0.03

# ============================================
# Development Settings
# ============================================
DEBUG=false
ENVIRONMENT=production  # or 'development'
